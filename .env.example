# ==========================================
# TBC CAR SPA - LINE INTEGRATION & SECURITY ENVIRONMENT CONFIG
# ==========================================

# --- FRONTEND (frontend/.env) ---
# LINE LIFF ID จาก LINE Developers Console (Channel > LIFF > LIFF ID)
VITE_LIFF_ID="YOUR_LINE_LIFF_ID_HERE"
VITE_API_BASE_URL="/api"
# LINE User ID ของเจ้าของร้าน (สำหรับปลดล็อกสิทธิ์ IAM Admin Dashboard)
VITE_ADMIN_LINE_USER_IDS="U1234567890abcdef1234567890abcdef"

# --- BACKEND (backend/.env) ---
PORT=5000
DATABASE_URL="file:./dev.db"

# LINE Messaging API & Official Account Credentials
LINE_CHANNEL_ID="YOUR_LINE_CHANNEL_ID_HERE"
LINE_CHANNEL_SECRET="YOUR_LINE_CHANNEL_SECRET_HERE"
LINE_CHANNEL_ACCESS_TOKEN="YOUR_LINE_CHANNEL_ACCESS_TOKEN_HERE"
LINE_LIFF_ID="YOUR_LINE_LIFF_ID_HERE"

# LINE User ID ของเจ้าของร้าน (สำหรับตรวจสอบสิทธิ์ Security Guard ใน Backend)
ADMIN_LINE_USER_IDS="U1234567890abcdef1234567890abcdef"
